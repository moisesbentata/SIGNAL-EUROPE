# --- Instagram Graph API (official publishing) ---
# Created via a Meta Developer App linked to a Business/Creator IG account
# that is connected to a Facebook Page. See README.md for the setup steps.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# --- Image hosting ---
# The Graph API requires a public image URL, not a local file upload.
# Point this at any host you control (S3 bucket, Cloudinary, your own
# static file server, etc). Generated images are uploaded here before
# being handed to the Graph API.
IMAGE_HOST_UPLOAD_URL=
IMAGE_HOST_PUBLIC_BASE_URL=

# --- X/Twitter monitoring (official API, paid tier required) ---
# Recent-search access requires at least the "Basic" developer plan.
# Leave blank to skip Twitter entirely (RSS sources still work fine).
TWITTER_BEARER_TOKEN=

# --- Instagram monitoring (unofficial, best-effort) ---
# Optional: a throwaway IG login used only for reading public profiles via
# instaloader. Leave blank to fetch anonymously (works for public accounts
# but is more likely to get rate-limited).
IG_WATCH_USERNAME=
IG_WATCH_PASSWORD=

# --- Behavior ---
# When "false" (default), new items are only written to review_queue/ as
# drafts. Set to "true" once you trust the pipeline enough to auto-publish.
AUTO_PUBLISH=false

# Posting cadence: at most this many posts (or review-queue drafts) per
# UTC day, across all runs. There's no way to force a *minimum* of 2/day —
# that depends on there being that much on-brand European tech/VC news —
# but schedule main.py every 1-2 hours (see README) and this cap keeps it
# from ever exceeding 3-4/day even on a heavy news day.
MAX_POSTS_PER_DAY=4
