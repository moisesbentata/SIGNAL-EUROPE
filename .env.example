# --- Telegram bot ---
# Create a bot via @BotFather on Telegram (free, takes ~1 minute) and
# put its token here.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to send links,
# manage the queue, and receive publish notifications. This is a real
# access control, not a courtesy — anyone who knows your bot's username
# could otherwise message it and post to YOUR Instagram account. Get
# your own numeric ID by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_IDS=

# --- Instagram Graph API (official publishing) ---
# Business/Creator IG account linked to a Facebook Page, Meta Developer
# App with instagram_content_publish permission — see README.md.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# --- Instagram scraper cookies (for downloading source reels) ---
# Instagram increasingly requires a logged-in session even for public
# reels. Export cookies.txt from a browser logged into a THROWAWAY IG
# account (not your posting account — Meta may sanction the account
# used for scraping), base64-encode the file, and paste the result here.
# On macOS/Linux: `base64 -i cookies.txt | pbcopy` or `base64 -w0 cookies.txt`.
# Without this, most downloads will fail with "login required".
IG_COOKIES_B64=

# The throwaway account's @handle (no leading @). Only needed for the
# instaloader fallback path — instaloader's is_logged_in flag requires
# a username string alongside the sessionid cookie, otherwise it
# treats the request as anonymous and Instagram redirects it to the
# login page (which surfaces as "JSON Query: Expecting value" in the
# bot's error message). If left blank the bot falls back to the
# ds_user_id from the cookie file, which usually works but is less
# reliable.
IG_USERNAME=

# --- LLM caption generator (Google Gemini vision) ---
# When you send a link without your own hook line, the bot passes the
# downloaded media (plus the source poster's caption as background
# context) to Gemini vision and asks for a caption in Signal Europe's
# voice: a hook, one Europe-angle context sentence, and a comment-farm
# question at the end. Get a free key at aistudio.google.com/apikey —
# gemini-2.0-flash is on the free tier at 1500 requests/day, more than
# enough for a few posts a day. Leave blank to skip the LLM entirely
# and get credit + hashtags only.
GEMINI_API_KEY=
# Optional: pin a specific model. Defaults to gemini-2.0-flash.
GEMINI_MODEL=

# --- Twitter/X scraper cookies (for downloading source videos) ---
# Twitter/X's guest read window has been shrinking; some videos require
# a logged-in session. Same pattern as IG_COOKIES_B64: export cookies
# from a throwaway X account and base64-encode. Optional — leave empty
# and the downloader falls back to anonymous fetches.
TWITTER_COOKIES_B64=

# --- Video hosting (Cloudinary) ---
# The Graph API needs the video at a public URL (it fetches it
# server-side). We upload each downloaded video to Cloudinary once and
# store the resulting public URL in the queue DB, so reposts reuse the
# same URL rather than re-uploading. Get CLOUDINARY_URL verbatim from
# your Cloudinary dashboard → Product Environment → API environment
# variable (format: cloudinary://<api_key>:<api_secret>@<cloud_name>).
CLOUDINARY_URL=

# --- Persistent storage ---
# The queue DB and any transient downloads live under DATA_DIR. On
# Railway, mount a persistent volume (Settings → Volumes) at /data and
# set DATA_DIR=/data — without this, the queue is wiped on every
# redeploy and scheduled posts disappear. Locally just leave the
# default.
DATA_DIR=data

# --- Posting cadence ---
# Min/max hours between consecutive posts. Each new link is scheduled
# at (last queued time) + a random gap in this range. Keeps the account
# from posting bursts, which Instagram penalizes.
MIN_POST_GAP_HOURS=4
MAX_POST_GAP_HOURS=5

# Quiet hours: posts are never published inside this window (any due
# item slides to the moment the window ends). Uses POSTING_TIMEZONE
# below — QUIET_HOURS_START may be greater than QUIET_HOURS_END to
# wrap midnight (23..8 = 11pm through 8am).
QUIET_HOURS_START=23
QUIET_HOURS_END=8
POSTING_TIMEZONE=Europe/Madrid

# --- Weekly repost job ---
# Every Sunday 22:00 (POSTING_TIMEZONE), the bot picks the top posts
# from the last WEEKLY_REPOST_LOOKBACK_DAYS days by Instagram reach
# and re-queues them across the coming week. Set WEEKLY_REPOST_ENABLED
# to "false" to disable (still available on demand via /reposts).
WEEKLY_REPOST_ENABLED=true
WEEKLY_REPOST_COUNT=3
WEEKLY_REPOST_LOOKBACK_DAYS=7
# Ignore posts fresher than this — reach numbers aren't representative
# until a post's had ~2 days to settle
WEEKLY_REPOST_MIN_AGE_HOURS=48
# Don't re-queue the same original more often than every N days
WEEKLY_REPOST_COOLDOWN_DAYS=30
# Prefix prepended to the caption on repost so Instagram doesn't flag
# it as identical duplicate content
WEEKLY_REPOST_PREFIX=Back by demand —
