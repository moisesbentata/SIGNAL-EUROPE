# --- Telegram bot ---
# Create a bot via @BotFather on Telegram (free, takes ~1 minute) and put
# its token here.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram numeric user IDs allowed to trigger a post.
# This is a real access control, not a courtesy — anyone who knows your
# bot's username could otherwise message it and post to YOUR Instagram
# account. Get your own numeric ID by messaging @userinfobot on Telegram.
TELEGRAM_ALLOWED_USER_IDS=

# --- Instagram Graph API (official publishing) ---
# Same setup as before: Business/Creator IG account linked to a Facebook
# Page, Meta Developer App with instagram_content_publish permission.
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# --- Video hosting ---
# The Graph API needs the video at a public URL (it fetches it
# server-side) — point this at any host you control (S3, Cloudinary, a
# small static file server). Same requirement as image hosting before.
VIDEO_HOST_UPLOAD_URL=
VIDEO_HOST_PUBLIC_BASE_URL=

# --- Behavior ---
# When "true", the bot asks you to confirm (inline Yes/No) before
# actually posting. Default here is "false" — it posts immediately on
# link receipt, on the assumption that you're vetting copyright/fit
# before you ever send the link. Flip to "true" if you want the
# confirmation step back.
REQUIRE_CONFIRMATION=false
